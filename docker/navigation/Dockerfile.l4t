ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# numpy, torch, torchvision, OpenCV (CUDA), cv_bridge and CycloneDDS/iceoryx
# come from l4t_base.

USER ros
SHELL ["/bin/bash", "-c"]

#Install dependencies
RUN sudo apt-get update -qq && sudo apt-get install -y -qq libboost-iostreams-dev libtbb-dev libblosc-dev \
    && sudo rm -rf /var/lib/apt/lists/*

# RTABMap links libtorch (WITH_TORCH): its libraries must be on the path to link
# and to run the rtabmap nodes.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/torch/lib:${LD_LIBRARY_PATH}

#Building rtabmap packages
ARG RTABMAP_COMMIT=1fe713cc1f870c36bbc7ae8d649b7682a988e8f3
ARG RTABMAP_ROS_COMMIT=73c98f87a807dd48d3f7d67ff18d77b4c69ac56c
RUN mkdir /home/ros/ros_packages3
WORKDIR /home/ros/ros_packages3
RUN git clone https://github.com/introlab/rtabmap.git src/rtabmap && git -C src/rtabmap checkout ${RTABMAP_COMMIT} && \
    git clone --branch ros2 https://github.com/introlab/rtabmap_ros.git src/rtabmap_ros && git -C src/rtabmap_ros checkout ${RTABMAP_ROS_COMMIT}
RUN sudo apt-get update && (sudo rosdep init || true) && rosdep update && \
    rosdep install --from-paths src --ignore-src -r --skip-keys "libvtk-qt libopencv-dev libopencv-contrib-dev python3-opencv" -y && \
    sudo rm -rf /var/lib/apt/lists/*
RUN sed -i '/PATTERN "\*.h"/a\    PATTERN "*.hpp"' src/rtabmap_ros/rtabmap_sync/CMakeLists.txt
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && with-cuda-stub colcon build --symlink-install --cmake-clean-cache --cmake-args \
    -DCMAKE_BUILD_TYPE=Release \
    -DOpenCV_DIR=/usr/local/lib/cmake/opencv4 \
    -DWITH_TORCH=ON \
    -DWITH_PYTHON=ON \
    -DTorch_DIR=$(with-cuda-stub python3 -c "import torch; print(torch.utils.cmake_prefix_path)")/Torch
RUN echo "source /home/ros/ros_packages3/install/setup.bash" >> /home/ros/.bashrc

# SuperPoint + SuperGlue models for RTABMap
RUN git clone --depth 1 https://github.com/magicleap/SuperGluePretrainedNetwork.git /home/ros/SuperGlue

# Copy RTABMap's SuperGlue wrapper script alongside the SuperGlue repo
RUN cp /home/ros/ros_packages3/src/rtabmap/corelib/src/python/rtabmap_superglue.py /home/ros/SuperGlue/

# Trace SuperPoint model with the installed PyTorch version
COPY docker/navigation/trace_superpoint.py /tmp/trace_superpoint.py
RUN mkdir -p /home/ros/models && with-cuda-stub python3 /tmp/trace_superpoint.py

ENV SUPERGLUE_PATH=/home/ros/SuperGlue
ENV SUPERPOINT_MODEL=/home/ros/models/superpoint_v1.pt

# OpenVDB (built and installed in one layer, sources removed)
WORKDIR /tmp
RUN wget -q https://github.com/AcademySoftwareFoundation/openvdb/archive/refs/tags/v10.0.0.zip && \
    unzip -q v10.0.0.zip && rm v10.0.0.zip && \
    cmake -S openvdb-10.0.0 -B openvdb-10.0.0/build && \
    cmake --build openvdb-10.0.0/build -j$(nproc) && \
    sudo cmake --install openvdb-10.0.0/build && \
    rm -rf openvdb-10.0.0

#Install dependencies
RUN sudo pip install pyserial
RUN sudo mkdir -p /workspace && sudo chown ros:ros /workspace
WORKDIR /workspace
COPY ./navigation /workspace/src
RUN sudo apt-get update && (sudo rosdep init || true) && rosdep update && \
    rosdep install --from-paths . --ignore-src --skip-keys "frida_constants frida_interfaces libvtk-qt ira_laser_tools sllidar_ros2 dashgo_driver map_context omnidriver p9n_node pcl eigen3 libopencv-dev python3-opencv" -y && \
    sudo rm -rf /workspace/src/ /var/lib/apt/lists/*

# ============================================================================
# Eigen MPPI: replace apt Nav2 with a from-source build that carries the Eigen
# nav2_mppi_controller — ~45-50% less controller CPU, and ARM-friendly (the
# xtensor MPPI lacks good NEON SIMD). Validated on the AGX Orin:
#   * BT.CPP v4 must be built inside the colcon ws (ament-aware) so it exports
#     the behaviortree_cpp::behaviortree_cpp target nav2 expects (raw upstream
#     only gives BT::behaviortree_cpp).
#   * Source nav2 CANNOT overlay apt nav2: apt installs headers into the merged
#     /opt/ros/<distro>/include, which shadows the source headers. So the apt
#     nav2-family is PURGED, and the runtime nav2 set + nav_2d_utils + STVL
#     (a nav2_costmap_2d plugin, so ABI-bound to costmap) are rebuilt.
#   * slam_toolbox needs NO rebuild (only an exec_depend on nav2_map_server).
#   * Build set == exactly the nodes the omni launch starts (controller/MPPI,
#     planner/navfn, behaviors, bt_navigator, smoother, velocity_smoother,
#     lifecycle_manager, map_server for keepout filters) + STVL.
# ============================================================================
ARG NAV2_BRANCH=jazzy
ARG BTCPP_TAG=4.6.2
ARG STVL_BRANCH=jazzy
RUN mkdir -p /home/ros/nav2_ws/src
WORKDIR /home/ros/nav2_ws
RUN git clone --depth 1 -b ${BTCPP_TAG} https://github.com/BehaviorTree/BehaviorTree.CPP.git src/BehaviorTree.CPP && \
    git clone --depth 1 -b ${STVL_BRANCH} https://github.com/SteveMacenski/spatio_temporal_voxel_layer.git src/spatio_temporal_voxel_layer && \
    git clone --depth 1 -b ${NAV2_BRANCH} https://github.com/ros-navigation/navigation2.git src/navigation2 && \
    cd src/navigation2 && \
    cp -r nav2_dwb_controller/nav_2d_utils nav2_dwb_controller/nav_2d_msgs /home/ros/nav2_ws/src/ && \
    rm -rf nav2_bringup nav2_system_tests nav2_loopback_sim nav2_rviz_plugins nav2_simple_commander \
           navigation2 nav2_docking nav2_smac_planner nav2_route nav2_dwb_controller \
           nav2_constrained_smoother nav2_graceful_controller nav2_regulated_pure_pursuit_controller \
           nav2_rotation_shim_controller nav2_theta_star_planner nav2_amcl
# Purge apt nav2-family so its merged headers/cmake don't shadow the source build.
RUN NAV2_APT=$(dpkg -l | awk -v d="${ROS_DISTRO}" '/^ii/ && ($2 ~ "^ros-"d"-nav2" || $2 ~ "^ros-"d"-nav-2d" || $2 ~ "^ros-"d"-dwb" || $2=="ros-"d"-navigation2") {print $2}' | tr '\n' ' ') && \
    if [ -n "$NAV2_APT" ]; then sudo dpkg --remove --force-depends $NAV2_APT; fi
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    MAKEFLAGS="-j6" colcon build --parallel-workers 2 \
      --packages-up-to nav2_bt_navigator nav2_mppi_controller nav2_controller nav2_navfn_planner \
        nav2_planner nav2_behaviors nav2_smoother nav2_velocity_smoother nav2_lifecycle_manager \
        nav2_map_server spatio_temporal_voxel_layer \
      --packages-skip openvdb_vendor \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf build log
# Source the from-source Nav2 BEFORE the /workspace overlay (sourced at runtime).
RUN echo "source /home/ros/nav2_ws/install/setup.bash" >> /home/ros/.bashrc

# CycloneDDS SHM (iceoryx built in l4t_base)
ENV CYCLONE_SHM=1
RUN /usr/local/bin/cyclonedds_setup.sh

# Patch: os.add_dll_directory is Windows-only but PyTorch calls it.
# RTABMap's embedded Python skips sitecustomize.py, so patch os.py directly.
RUN sudo sed -i '$ a\# Patch for RTABMap embedded Python + PyTorch\ntry:\n    add_dll_directory\nexcept NameError:\n    add_dll_directory = lambda path: None' /usr/lib/python3.12/os.py

WORKDIR /workspace
