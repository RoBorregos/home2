ARG BASE_IMAGE=roborregos/home2:cuda_base
FROM ${BASE_IMAGE}
ARG ROS_DISTRO=jazzy
USER ros
SHELL ["/bin/bash", "-c"]

# CycloneDDS (network-only) comes from cuda_base; SHM is Jetson-only (see Dockerfile.l4t).

RUN pip install --upgrade pip
RUN pip install pyserial
WORKDIR /workspace
COPY ./navigation /workspace/src
RUN sudo apt-get update && (sudo rosdep init || true) && rosdep update && \
    rosdep install --from-paths . --ignore-src --skip-keys "frida_constants frida_interfaces pcl eigen3 libvtk-qt" -y && \
    sudo rm -rf /workspace/src/ /var/lib/apt/lists/*
