ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

# Install audio and speech synthesis dependencies natively for L4T
RUN apt-get update && apt-get install -y \
    libopenmpi-dev \
    libportaudio2 \
    libportaudiocpp0 \
    portaudio19-dev \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (numpy/scipy/torch come from l4t_base)
WORKDIR /app
COPY ../../hri/requirements/tts.txt requirements.txt
COPY ../../hri/proto_interfaces /tmp/proto_interfaces
RUN pip-install-reqs /app/requirements.txt && \
    pip install --upgrade protobuf && \
    python3 -m spacy download en_core_web_sm && \
    pip install /tmp/proto_interfaces && \
    rm -rf /tmp/proto_interfaces
