# dustynv/l4t-pytorch has no JetPack 7 (L4T r38+) tag yet — build on our own
# jazzy_l4t_base instead, which already has the `ros` user + a Jetson pip
# index (see docker/Dockerfile.ROS-l4t for PIP_INDEX_URL/PIP_INDEX_JETSON).
ARG BASE_IMAGE=roborregos/home2:jazzy_l4t_base
FROM ${BASE_IMAGE}

# Install audio and speech synthesis dependencies natively for L4T
RUN apt-get update && apt-get install -y \
    python3-venv \
    libopenmpi-dev \
    libportaudio2 \
    libportaudiocpp0 \
    portaudio19-dev \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN pip install virtualenv

# Install Python dependencies
WORKDIR /app
COPY ../../hri/requirements/tts.txt requirements.txt
RUN python3 -m pip install --upgrade pip
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN pip install --upgrade protobuf
RUN python3 -m spacy download en_core_web_sm

COPY ../../hri/proto_interfaces /tmp/proto_interfaces
RUN pip install --no-cache-dir /tmp/proto_interfaces