ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenmpi-dev \
    libportaudio2 \
    libportaudiocpp0 \
    portaudio19-dev \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY hri/requirements/tts.txt /tmp/requirements/tts.txt
COPY hri/proto_interfaces /tmp/proto_interfaces
RUN pip-install-reqs /tmp/requirements/tts.txt \
    && python3 -m spacy download en_core_web_sm \
    && pip install /tmp/proto_interfaces \
    && rm -rf /tmp/requirements /tmp/proto_interfaces
