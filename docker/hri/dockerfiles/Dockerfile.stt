ARG BASE_IMAGE=python:3.10-bookworm
FROM ${BASE_IMAGE}

# Keep Python dependencies isolated from distro-managed Python.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv "$VIRTUAL_ENV"

COPY hri/requirements/stt.txt /tmp/requirements/stt.txt
COPY hri/proto_interfaces /tmp/proto_interfaces
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements/stt.txt requests==2.32.5 \
    && pip install /tmp/proto_interfaces \
    && rm -rf /tmp/requirements /tmp/proto_interfaces
