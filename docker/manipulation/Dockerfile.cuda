# Devel image for access to CUDA compilation
ARG BASE_IMAGE=roborregos/home2:cuda_base
FROM ${BASE_IMAGE} AS base

LABEL maintainer="RoBorregos <roborregosteam@gmail.com>"

FROM base AS manipulation

ARG ROS_DISTRO=jazzy
ENV DEBIAN_FRONTEND=noninteractive

RUN mkdir -p /workspace/requirements

# ROS Requirements, will need several tools from desktop TODO: change desktop for specific dependencies
RUN apt update && apt install -y ros-${ROS_DISTRO}-desktop ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-moveit ros-${ROS_DISTRO}-laser-geometry

# Python Requirements
COPY manipulation/requirements.txt /workspace/requirements/requirements.txt
# Single pip call so torch/numpy are installed once (PIP_IGNORE_INSTALLED=1 in the base
# makes a second call overlay a different version instead of replacing it). Same pins as vision.
RUN pip3 install torch==2.6.0 torchvision==0.21.0 -r /workspace/requirements/requirements.txt \
    --extra-index-url https://download.pytorch.org/whl/cu124

RUN mkdir -p /workspace/src/
RUN mkdir -p /installs
RUN chown -R ros:ros /workspace
RUN chown -R ros:ros /installs

RUN apt update && apt install -y ros-${ROS_DISTRO}-zed-msgs ros-${ROS_DISTRO}-moveit*
# prebuild and more
WORKDIR /installs
RUN git clone https://github.com/RoBorregos/home2 --recursive home2_install
WORKDIR /installs/home2_install
RUN rosdep init && rosdep update && rosdep install --from-paths /installs/home2_install --ignore-src -r --skip-keys "gpd opencv message_package eigen3 pcl-ros gazebo_ros gazebo_plugins libpcl-dev gazebo_ros2_control libvtk-qt" -y
RUN rosdep fix-permissions
RUN cd manipulation/packages/gpd && mkdir -p build && cd build && cmake .. && make && make install

RUN echo ". /home/ros/setup_gpd.sh" >> /home/ros/.bashrc
RUN echo "export GPD_INSTALL_DIR=/workspace/install/gpd" >> /home/ros/.bashrc
RUN echo "source /workspace/frida_interfaces_cache/install/setup.bash" >> /home/ros/.bashrc

# CycloneDDS
RUN sudo apt-get update -qq && sudo apt-get install -y -qq ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    && sudo rm -rf /var/lib/apt/lists/*
COPY docker/cyclonedds_setup.sh /usr/local/bin/cyclonedds_setup.sh
RUN sudo chmod +x /usr/local/bin/cyclonedds_setup.sh && sudo /usr/local/bin/cyclonedds_setup.sh
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml
RUN echo "source /usr/local/bin/cyclonedds_setup.sh" >> /home/ros/.bashrc

WORKDIR /workspace