# CPU image for GIGA training (laptops, no NVIDIA runtime).
# Keep it in sync with Dockerfile.giga (GPU): same packages, same order.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Headless OpenGL. Only matters for GIGA's visualization code, not training.
ENV PYOPENGL_PLATFORM=osmesa

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    git \
    build-essential \
    cmake \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libusb-1.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libosmesa6-dev \
    freeglut3-dev \
    ninja-build \
    wget \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN python3 -m pip install --upgrade pip setuptools wheel

# CPU-only torch wheel: skips several GB of unused CUDA libraries.
RUN pip3 install torch==2.2.0 torchvision==0.17.0 torchaudio==2.2.0 \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip3 install torch-scatter -f https://data.pyg.org/whl/torch-2.2.0+cpu.html

# Every version is pinned so all machines build the same image.
# numpy must stay <2: GIGA's C++/Cython extensions use the NumPy 1.x C API.
RUN pip3 install \
    catkin_pkg==1.1.1 \
    numpy==1.26.4 \
    scipy==1.15.3 \
    pandas==2.3.3 \
    matplotlib==3.10.9 \
    h5py==3.16.0 \
    tensorboard==2.21.0 \
    tqdm==4.70.1 \
    cython==3.3.0 \
    scikit-image==0.19.3 \
    pykdtree==1.4.3

RUN pip3 install pybullet==3.2.7 trimesh==5.1.0 urdfpy==0.0.22 pyrender==0.1.45

# urdfpy asks for networkx==2.2, which is broken on Python 3.10, so we
# override it with 2.8.8. `pip check` will complain; that is expected.
RUN pip3 install networkx==2.8.8 pycollada==0.6 lxml==6.1.3 six==1.17.0

# Own layer because it is the biggest wheel (~450MB). Needs libusb-1.0-0 above.
RUN pip3 install open3d==0.19.0

RUN pip3 install pytorch-ignite==0.5.5 wandb==0.30.0

# GIGA's source is mounted at run time, not copied in. setup_giga.sh installs
# it and builds its extensions on the first shell.
RUN echo ". /root/setup_giga.sh" >> /root/.bashrc

CMD ["/bin/bash"]
