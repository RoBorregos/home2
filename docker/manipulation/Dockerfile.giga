# GPU variant of Dockerfile.giga-cpu. Same package set, same layer order --
# the only differences are the CUDA base image and the CUDA-linked wheels,
# so the two files stay easy to diff against each other.
#
# Use this one to actually train: GIGA's ConvONets encoder over a 40^3 grid
# is the part that needs the GPU. The CPU image exists for developing and
# smoke-testing the pipeline on a laptop, not for producing a model.
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Data generation renders depth with PyBullet's software rasterizer, which
# needs no GL context. osmesa keeps pyrender-based visualization importable
# on a headless box; EGL would need the display libraries wired through.
ENV PYOPENGL_PLATFORM=osmesa

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    git \
    build-essential \
    cmake \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libosmesa6-dev \
    freeglut3-dev \
    ninja-build \
    wget \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN python3 -m pip install --upgrade pip setuptools wheel

RUN pip3 install torch==2.2.0 torchvision==0.17.0 torchaudio==2.2.0 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip3 install torch-scatter -f https://data.pyg.org/whl/torch-2.2.0+cu121.html

# numpy pinned <2: GIGA's vendored ConvONets C++/Cython extensions use the
# classic NumPy 1.x C API (PyArray_DOUBLE, ...), removed in NumPy 2.x --
# building against 2.x is a compile error, not a deprecation warning.
RUN pip3 install \
    catkin_pkg \
    numpy==1.26.4 \
    scipy \
    pandas \
    matplotlib \
    h5py \
    tensorboard \
    tqdm \
    cython \
    scikit-image \
    pykdtree

RUN pip3 install pybullet trimesh urdfpy pyrender

RUN pip3 install open3d

RUN pip3 install pytorch-ignite==0.5.5 wandb

# GIGA's source is NOT baked into the image -- it is bind-mounted from the
# repo's own submodule at run time, and setup_giga.sh does the editable
# install plus the ConvONets extension build on the first shell.
RUN echo ". /root/setup_giga.sh" >> /root/.bashrc

CMD ["/bin/bash"]
