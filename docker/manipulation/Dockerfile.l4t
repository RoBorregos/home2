ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# numpy, scipy, torch, OpenCV (CUDA) and CycloneDDS come from l4t_base.

RUN mkdir -p /workspace

# Python Requirements (base-provided pins in the shared file are skipped)
COPY manipulation/requirements.txt /tmp/requirements.txt
RUN pip-install-reqs /tmp/requirements.txt && rm /tmp/requirements.txt

RUN chown -R ros:ros /workspace

RUN apt-get update && apt-get install -y ros-${ROS_DISTRO}-zed-msgs ros-${ROS_DISTRO}-moveit* \
    && rm -rf /var/lib/apt/lists/*

# Install manipulation dependencies from the package.xml files of this checkout
# (bind mount: nothing from the context is stored in the image)
RUN --mount=type=bind,source=.,target=/installs/home2_install \
    apt-get update && (rosdep init || true) && rosdep update && \
    rosdep install --from-paths /installs/home2_install/ --ignore-src -r --skip-keys "gpd opencv message_package eigen3 pcl-ros gazebo_ros gazebo_plugins libpcl-dev gazebo_ros2_control libvtk-qt libopencv-dev python3-opencv" -y && \
    rosdep fix-permissions && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /

#Copying GPD script and variables
RUN echo ". /home/ros/setup_gpd.sh" >> /home/ros/.bashrc
RUN echo "export GPD_INSTALL_DIR=/workspace/install/gpd" >> /home/ros/.bashrc
RUN echo "source /workspace/frida_interfaces_cache/install/setup.bash" >> /home/ros/.bashrc

WORKDIR /workspace
