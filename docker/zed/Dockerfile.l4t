# Stereolabs has not published a ZED SDK build tagged for L4T r39 specifically
# (`.../zedsdk/5.4/l4t39.2/jetsons` 302s to the generic homepage — confirmed
# 2026-08-20). But their l4t38.4 build (JetPack 7.0/7.1, one minor L4T rev
# behind our r39.2 host) DOES exist and works in practice: verified live on
# real Orin hardware with a physical ZED 2 (USB) — camera opens, RGB grab,
# and classical (non-NEURAL) depth (ULTRA mode) all succeed via
# stereolabs/zed:5.4.1-tools-devel-l4t-r38.4's bundled pyzed. Caveat: NEURAL/
# AI depth mode fails — that build's bundled TensorRT engine builder rejects
# "Target GPU SM 87" (Ampere), likely because this particular l4t38.4 image
# predates broad SM87 TensorRT plan support. Non-AI depth modes (PERFORMANCE/
# QUALITY/ULTRA) are CUDA stereo matching only, no TensorRT, and work fine.
ARG BASE_IMAGE=roborregos/home2:jazzy_l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# Install ZED SDK (silent, skip drivers for container use) — l4t38.4 build,
# see note above on why not l4t39.2 (doesn't exist) or l4t36.4 (JetPack 6,
# further from this host's actual r39.2 than 38.4 is).
# sudo -E (not plain sudo): the installer's internal pip calls need
# PIP_IGNORE_INSTALLED=1 from the base image (see docker/Dockerfile.ROS-l4t)
# to avoid "Cannot uninstall numpy 1.26.4, RECORD file not found" — Debian's
# apt-provided numpy has no RECORD file for pip to reference. Plain `sudo`
# resets the environment by default and drops that var, breaking the fix.
RUN sudo apt-get update -qq && sudo apt-get install -y -qq zstd && \
    wget -q -O /tmp/ZED_SDK.run \
    https://download.stereolabs.com/zedsdk/5.4/l4t38.4/jetsons && \
    chmod +x /tmp/ZED_SDK.run && \
    sudo -E /tmp/ZED_SDK.run silent skip_drivers && \
    sudo rm -rf /tmp/ZED_SDK.run /usr/local/zed/resources/*

# The SDK's NEURAL/NEURAL_LIGHT depth modes (the only ones zed_wrapper 5.x
# exposes — classical PERFORMANCE/QUALITY/ULTRA modes still work via the raw
# SDK API but aren't wired into the ROS2 wrapper's config schema anymore)
# need TensorRT's ONNX parser at runtime to build the AI depth-inference
# engine. jazzy_l4t_base bakes in libnvinfer* (see docker/Dockerfile.ROS-l4t)
# but not the ONNX parser package — install it here since it's zed-specific,
# not something every other l4t area needs.
RUN sudo apt-get update -qq && sudo apt-get install -y -qq libnvonnxparsers10 && \
    sudo rm -rf /var/lib/apt/lists/*

# Symlink for v4l2 (required by ZED SDK in containers)
RUN sudo ln -sf /usr/lib/$(uname -m)-linux-gnu/tegra/libv4l2.so.0 \
    /usr/lib/$(uname -m)-linux-gnu/libv4l2.so 2>/dev/null || true

# zed-ros2-wrapper dropped distro-prefixed tags after humble-v5.1.0 — v5.2.0+
# is distro-agnostic (auto-detects ROS_DISTRO from the environment at build
# time), so v5.4.1 (matching the SDK version installed above) works on Jazzy.
RUN mkdir -p /opt/zed_ws/src && cd /opt/zed_ws/src && \
    git clone --depth 1 -b v5.4.1 https://github.com/stereolabs/zed-ros2-wrapper.git && \
    cd /opt/zed_ws && \
    sudo apt-get update -qq && \
    sudo rosdep init 2>/dev/null || true && \
    rosdep update && \
    rosdep install --from-paths src -y --ignore-src && \
    sudo rm -rf /var/lib/apt/lists/*

# zed_debug links directly against libcuda.so/OpenGL/NvBufSurface (Jetson
# multimedia + driver stub libs), which only exist on a host with the real
# NVIDIA driver — not in a driver-less `docker build` sandbox (same class of
# issue as OpenCV's cudacodec module, see docker/navigation/Dockerfile.l4t).
# It's a standalone debug/visualization tool, not needed by the core wrapper
# nodes (zed_components etc.) — skip it rather than fight the link step.
RUN cd /opt/zed_ws && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --cmake-args -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        --packages-skip zed_debug && \
    sudo chown -R ros:ros /opt/zed_ws

# CycloneDDS with SHM (iceoryx zero-copy for camera frames)
# Iceoryx from source (expanded publisher/subscriber limits)
RUN sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends libacl1-dev && sudo rm -rf /var/lib/apt/lists/* && \
    sudo dpkg --force-depends -r ros-${ROS_DISTRO}-iceoryx-posh ros-${ROS_DISTRO}-iceoryx-hoofs ros-${ROS_DISTRO}-iceoryx-binding-c 2>/dev/null || true
RUN cd /tmp && \
    git clone --depth 1 -b v2.0.6 https://github.com/eclipse-iceoryx/iceoryx.git && \
    cd iceoryx && \
    sed -i 's|set(IOX_INTERNAL_MAX_NUMBER_OF_NOTIFIERS 256)|set(IOX_INTERNAL_MAX_NUMBER_OF_NOTIFIERS 1024)|' iceoryx_posh/cmake/IceoryxPoshDeployment.cmake && \
    cmake -S iceoryx_meta -B build \
        -DCMAKE_INSTALL_PREFIX=/opt/ros/${ROS_DISTRO} \
        -DIOX_MAX_PUBLISHERS=20000 \
        -DIOX_MAX_SUBSCRIBERS=20000 \
        -DIOX_MAX_CHUNKS_HELD_PER_SUBSCRIBER_SIMULTANEOUSLY=2048 \
        -DBUILD_BINDING_C=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j$(nproc) && \
    sudo cmake --install build && \
    sudo ldconfig && \
    cd / && rm -rf /tmp/iceoryx

RUN cd /tmp && \
    git clone --depth 1 -b releases/0.10.x https://github.com/eclipse-cyclonedds/cyclonedds.git && \
    cd cyclonedds && mkdir build && cd build && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/opt/ros/${ROS_DISTRO} \
        -DCMAKE_PREFIX_PATH=/opt/ros/${ROS_DISTRO} \
        -DENABLE_SHM=ON \
        -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && sudo make install && \
    cd / && rm -rf /tmp/cyclonedds

COPY docker/cyclonedds_setup.sh /tmp/cyclonedds_setup.sh
COPY roudi_config.toml /tmp/roudi_config.toml
RUN sudo cp /tmp/cyclonedds_setup.sh /usr/local/bin/cyclonedds_setup.sh && \
    sudo chmod +x /usr/local/bin/cyclonedds_setup.sh && \
    sudo mkdir -p /etc/iceoryx && sudo cp /tmp/roudi_config.toml /etc/iceoryx/roudi_config.toml
ENV CYCLONE_SHM=1
RUN sudo /usr/local/bin/cyclonedds_setup.sh

# CycloneDDS config without SHM (for robot_state_publisher)
RUN echo '<?xml version="1.0"?><CycloneDDS><Domain><SharedMemory><Enable>false</Enable><LogLevel>warn</LogLevel></SharedMemory></Domain></CycloneDDS>' > /opt/zed_ws/cyclonedds_noshm.xml

# Copy SHM override and wrapper launch
COPY zed_shm_override.yaml /opt/zed_ws/zed_shm_override.yaml
COPY zed_shm_launch.py /opt/zed_ws/zed_shm_launch.py

# ZED SDK library path
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/zed/lib"

# Source ZED workspace on shell login
RUN echo "source /opt/zed_ws/install/setup.bash" >> ~/.bashrc
