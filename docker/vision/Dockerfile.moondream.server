ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN echo "${BASE_IMAGE}"

RUN apt-get update && apt-get install -y libvips-dev --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# One pip run. On l4t, pip-install-reqs (from l4t_base) skips the pins the base
# already provides (numpy, OpenCV with CUDA, torch).
RUN printf '%s\n' "transformers==4.40.0" accelerate "huggingface-hub==0.30.2" "numpy==1.26.4" \
        opencv-python Pillow pyvips einops "grpcio==1.71.0" "protobuf==5.29.1" > /tmp/requirements.txt \
    && if command -v pip-install-reqs >/dev/null; then pip-install-reqs /tmp/requirements.txt; \
       else pip install -r /tmp/requirements.txt; fi \
    && rm /tmp/requirements.txt
RUN python3 -c "import numpy as np; print(np.__version__)"

WORKDIR /workspace
# Keep model downloads in the mounted, writable cache volume.
ENV HF_HOME=/home/ros/.cache/huggingface \
	HF_HUB_CACHE=/home/ros/.cache/huggingface
