ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN echo "${BASE_IMAGE}"

RUN pip install transformers==4.40.0 accelerate huggingface-hub==0.30.2
RUN pip install numpy==1.26.4
RUN pip install opencv-python
RUN pip install Pillow
RUN apt update
RUN apt install libvips-dev --no-install-recommends -y
RUN pip install pyvips
RUN pip install einops
RUN pip install grpcio==1.71.0
RUN pip install protobuf==5.29.1
RUN python3 -c "import numpy as np; print(np.__version__)"

WORKDIR /workspace
# Keep model downloads in the mounted, writable cache volume.
ENV HF_HOME=/home/ros/.cache/huggingface \
	HF_HUB_CACHE=/home/ros/.cache/huggingface
