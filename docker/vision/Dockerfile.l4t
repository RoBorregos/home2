ARG BASE_IMAGE=roborregos/home2:jazzy_l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# ── Orin AGX (sm_87) performance environment ──
ENV CUDA_ARCHITECTURES=87
ENV CMAKE_CUDA_ARCHITECTURES=87
ENV TORCH_CUDA_ARCH_LIST="8.7"
ENV OPENBLAS_CORETYPE=ARMV8

# ── System dependencies (single consolidated layer) ──
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential ffmpeg libsm6 libxext6 autoconf libtool mesa-utils \
    terminator nano git wget iputils-ping cmake \
    libcanberra-gtk-module libcanberra-gtk3-module \
    libx11-xcb1 libxkbcommon-x11-0 \
    libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-shape0 libxcb-xfixes0 libxcb-xinerama0 \
    libxcb-cursor0 libxcb-xkb1 libjpeg-dev \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# ── dlib with CUDA for Orin AGX (sm_87) ──
WORKDIR /workspace
RUN wget -q http://dlib.net/files/dlib-20.0.tar.bz2 && \
    tar jxf dlib-20.0.tar.bz2 && rm dlib-20.0.tar.bz2 && \
    cd dlib-20.0 && \
    sed -i 's/-arch=sm_50/-arch=sm_87/' dlib/cmake_utils/test_for_cuda/CMakeLists.txt && \
    # dlib 20.0's -DCUDA_ARCHITECTURES/-DCMAKE_CUDA_ARCHITECTURES are ignored; it
    # reads its own -DDLIB_USE_CUDA_COMPUTE_CAPABILITIES (default 50/Maxwell,
    # which CUDA 13's nvcc rejects outright — dropped after CUDA 11). Both the
    # sed above (its bundled CUDA-compiler smoke test) and this flag (the real
    # build) need to target sm_87 or the whole thing silently falls back to CPU.
    mkdir build && cd build && \
    cmake .. \
      -DDLIB_USE_CUDA=1 \
      -DUSE_AVX_INSTRUCTIONS=0 \
      -DUSE_NEON=1 \
      -DCUDA_HOST_COMPILER=/usr/bin/gcc \
      -DCMAKE_PREFIX_PATH=/usr/local/cuda \
      -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
      -DCUDAToolkit_ROOT=/usr/local/cuda \
      -DCMAKE_BUILD_TYPE=Release \
      -DCUDA_ARCHITECTURES="87" \
      -DCMAKE_CUDA_ARCHITECTURES="87" \
      -DDLIB_USE_CUDA_COMPUTE_CAPABILITIES=87 \
      -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
      -DCMAKE_CXX_FLAGS=-fno-lto \
      -DCMAKE_C_FLAGS=-fno-lto && \
    cmake --build . --config Release -- -j$(nproc) && \
    cd /workspace/dlib-20.0 && \
    python3 setup.py install --set DLIB_USE_CUDA=1 --set USE_NEON=1 --set CUDA_ARCHITECTURES=87 \
      --set DLIB_USE_CUDA_COMPUTE_CAPABILITIES=87 --set CMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
      --set CMAKE_CXX_FLAGS=-fno-lto --set CMAKE_C_FLAGS=-fno-lto && \
    cd /workspace && rm -rf dlib-20.0

# ── Python dependencies ──
# NOTE: Do NOT install opencv-python — the L4T base image includes
# OpenCV built with CUDA/TensorRT. Pip opencv-python overwrites it
# with a CPU-only build, killing GPU acceleration.
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    numpy==1.26.4 \
    cmake==3.25.2 \
    insightface \
    ultralytics==8.4.19 \
    lap \
    tqdm \
    pillow \
    timm \
    pyyaml \
    scipy \
    onnxslim>=0.1.71 \
    grpcio==1.71.0 \
    protobuf==5.29.1

# ── YOLOv5 for legacy YoloV5ObjectDetector ──
WORKDIR /workspace
RUN git clone --depth 1 https://github.com/ultralytics/yolov5.git

# ── Iceoryx from source (expanded publisher/subscriber limits) ──
# libboost-dev/libboost-python-dev installed here (not later, next to the
# from-source cv_bridge build that actually needs them): once the
# dpkg --force-depends -r below runs, the package DB is left with dangling
# Depends (ros-${ROS_DISTRO}-cyclonedds/rmw-cyclonedds-cpp still reference
# the force-removed iceoryx packages) — any apt-get install attempted AFTER
# that point fails with "Unmet dependencies" for completely unrelated
# packages too, since apt refuses to plan installs while known-broken nodes
# exist anywhere in the dependency graph.
RUN apt-get update -qq && apt-get install -y --no-install-recommends libacl1-dev libboost-dev libboost-python-dev && rm -rf /var/lib/apt/lists/* && \
    dpkg --force-depends -r ros-${ROS_DISTRO}-iceoryx-posh ros-${ROS_DISTRO}-iceoryx-hoofs ros-${ROS_DISTRO}-iceoryx-binding-c 2>/dev/null || true
RUN cd /tmp && \
    git clone --depth 1 -b v2.0.6 https://github.com/eclipse-iceoryx/iceoryx.git && \
    cd iceoryx && \
    sed -i 's|set(IOX_INTERNAL_MAX_NUMBER_OF_NOTIFIERS 256)|set(IOX_INTERNAL_MAX_NUMBER_OF_NOTIFIERS 1024)|' iceoryx_posh/cmake/IceoryxPoshDeployment.cmake && \
    cmake -S iceoryx_meta -B build \
        -DCMAKE_INSTALL_PREFIX=/opt/ros/${ROS_DISTRO} \
        -DIOX_MAX_PUBLISHERS=20000 \
        -DIOX_MAX_SUBSCRIBERS=20000 \
        -DIOX_MAX_CHUNKS_HELD_PER_SUBSCRIBER_SIMULTANEOUSLY=2048 \
        -DBUILD_BINDING_C=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j$(nproc) && \
    cmake --install build && \
    ldconfig && \
    cd / && rm -rf /tmp/iceoryx

# ── CycloneDDS with SHM (iceoryx zero-copy) ──
RUN cd /tmp && \
    git clone --depth 1 -b releases/0.10.x https://github.com/eclipse-cyclonedds/cyclonedds.git && \
    cd cyclonedds && mkdir build && cd build && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/opt/ros/${ROS_DISTRO} \
        -DCMAKE_PREFIX_PATH=/opt/ros/${ROS_DISTRO} \
        -DENABLE_SHM=ON \
        -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && \
    cd / && rm -rf /tmp/cyclonedds

COPY docker/cyclonedds_setup.sh /usr/local/bin/cyclonedds_setup.sh
COPY roudi_config.toml /etc/iceoryx/roudi_config.toml
ENV CYCLONE_SHM=1
RUN chmod +x /usr/local/bin/cyclonedds_setup.sh && /usr/local/bin/cyclonedds_setup.sh
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml
RUN echo "source /usr/local/bin/cyclonedds_setup.sh" >> /home/ros/.bashrc

# ── TensorRT engine cache ──
# Mount a host volume here to persist TensorRT engines across container restarts.
# Without this, engines are re-exported on every `docker run` (takes ~2-5 min per model).
# Usage: docker run -v /path/on/host:/workspace/trt_cache ...
RUN mkdir -p /workspace/trt_cache && chmod 777 /workspace/trt_cache
ENV TENSORRT_CACHE_DIR=/workspace/trt_cache

# ── Orin AGX max performance at runtime ──
# Set MAXN power mode and max clocks before running vision nodes:
#   sudo nvpmodel -m 0 && sudo jetson_clocks
# These require host-level access and cannot be set inside the container.

USER ros

# ── onnxruntime-gpu (must install as ros user) ──
# The ros user's pip config includes pypi.jetson-ai-lab.io, which provides
# the Jetson-optimized build with TensorrtExecutionProvider + CUDAExecutionProvider.
RUN pip install --no-cache-dir onnxruntime-gpu

# cv_bridge vs. cv2: NOT the same numpy conflict as navigation. Here it's the
# opposite direction. jazzy_l4t_base's cv2 (the CUDA/TensorRT-accelerated
# OpenCV NVIDIA bakes into the L4T image, /usr/local/lib/python3.12/dist-
# packages/cv2, version 4.11.0) needs NumPy >=2 — it fails to import under
# 1.26.4. But apt's ros-jazzy-cv-bridge was compiled by the ROS build farm
# against noble's system OpenCV/numpy (python3-opencv 4.6.0 + python3-numpy
# 1.26.4) and its boost extension breaks under NumPy 2.x. Forcing numpy<2
# (as navigation's Dockerfile does) would fix cv_bridge but break the far
# more important CUDA cv2 — so instead, rebuild cv_bridge from source here,
# against whatever numpy/OpenCV are actually active in this image (2.x /
# the NVIDIA 4.11.0 build), so both halves agree. vision_opencv has no
# `jazzy` branch yet; `rolling` is the closest current-development target.
RUN sudo dpkg --force-depends -r ros-${ROS_DISTRO}-cv-bridge 2>/dev/null || true
RUN mkdir -p /tmp/cv_bridge_ws/src && cd /tmp/cv_bridge_ws/src && \
    git clone --depth 1 -b rolling https://github.com/ros-perception/vision_opencv.git && \
    cd /tmp/cv_bridge_ws && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --packages-select cv_bridge --cmake-args -Wno-dev -DCMAKE_BUILD_TYPE=Release && \
    sudo cp -a install/cv_bridge/. /opt/ros/${ROS_DISTRO}/ && \
    sudo ldconfig && \
    cd / && rm -rf /tmp/cv_bridge_ws
