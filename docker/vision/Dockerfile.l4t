ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# ── Orin AGX (sm_87) performance environment ──
ENV CUDA_ARCHITECTURES=87
ENV CMAKE_CUDA_ARCHITECTURES=87
ENV TORCH_CUDA_ARCH_LIST="8.7"
ENV OPENBLAS_CORETYPE=ARMV8

# numpy, torch, torchvision, OpenCV (CUDA), cv_bridge, onnxruntime-gpu (TensorRT EP),
# TensorRT python and CycloneDDS/iceoryx come from l4t_base.

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    curl libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*

# Disable Ultralytics' runtime auto-install of missing packages (e.g. tensorrt,
# onnx). It bypasses our pinned versions and pulls unpinned ones at runtime,
# which requires internet access we won't have at competition time.
ENV YOLO_AUTOINSTALL=false

RUN pip install \
    cmake==3.25.2 \
    lap \
    tqdm \
    pillow \
    timm \
    pyyaml \
    "onnxslim>=0.1.71" \
    grpcio==1.71.0 \
    protobuf==5.29.1 \
    matplotlib \
    polars \
    psutil \
    requests \
    scikit-image \
    onnx \
    ultralytics-thop && \
    pip install --no-deps insightface==1.0.1 ultralytics==8.4.19

WORKDIR /workspace

# ── CycloneDDS SHM (iceoryx built in l4t_base) ──
ENV CYCLONE_SHM=1
RUN /usr/local/bin/cyclonedds_setup.sh

# ── TensorRT engine cache ──
# Mount a host volume here to persist TensorRT engines across container restarts.
# Without this, engines are re-exported on every `docker run` (takes ~2-5 min per model).
# Usage: docker run -v /path/on/host:/workspace/trt_cache ...
RUN mkdir -p /workspace/trt_cache && chmod 777 /workspace/trt_cache
ENV TENSORRT_CACHE_DIR=/workspace/trt_cache

# ── Orin AGX max performance at runtime ──
# Set MAXN power mode and max clocks before running vision nodes:
#   sudo nvpmodel -m 0 && sudo jetson_clocks
# These require host-level access and cannot be set inside the container.

USER ros
