ARG BASE_IMAGE=roborregos/home2:l4t_base
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy

# ── Orin AGX (sm_87) performance environment ──
ENV CUDA_ARCHITECTURES=87
ENV CMAKE_CUDA_ARCHITECTURES=87
ENV TORCH_CUDA_ARCH_LIST="8.7"
ENV OPENBLAS_CORETYPE=ARMV8

# numpy, torch, torchvision, OpenCV (CUDA), cv_bridge, onnxruntime-gpu (TensorRT EP),
# TensorRT python and CycloneDDS/iceoryx come from l4t_base.

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    curl libjpeg-dev libportaudio2 \
    && rm -rf /var/lib/apt/lists/*

# Disable Ultralytics' runtime auto-install of missing packages (e.g. tensorrt,
# onnx). It bypasses our pinned versions and pulls unpinned ones at runtime,
# which requires internet access we won't have at competition time.
ENV YOLO_AUTOINSTALL=false

# Keep the same CLIP implementation as the CPU/CUDA vision images. The base
# image's pip constraints preserve its Jetson torch/torchvision versions.
COPY vision/requirements/clip.txt /tmp/clip-requirements.txt
RUN pip install -r /tmp/clip-requirements.txt

# Python requirements (pins that l4t_base already provides are skipped).
# The second file is installed with --no-deps so these packages can't replace
# the base's torch, numpy and OpenCV builds.
COPY vision/requirements /tmp/requirements
RUN pip-install-reqs /tmp/requirements/l4t.txt && \
    pip-install-reqs /tmp/requirements/l4t-nodeps.txt -- --no-deps && \
    rm -rf /tmp/requirements

WORKDIR /workspace

# ── CycloneDDS SHM (iceoryx built in l4t_base) ──
ENV CYCLONE_SHM=1
RUN /usr/local/bin/cyclonedds_setup.sh

# ── TensorRT engine cache ──
RUN mkdir -p /workspace/trt_cache && chmod 777 /workspace/trt_cache
ENV TENSORRT_CACHE_DIR=/workspace/trt_cache


USER ros
