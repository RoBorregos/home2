<!--
  Person following: chase the moving goal that person_goal_smoother publishes on
  /goal_update (GoalUpdater swaps it into every replan). nav_central sends this
  tree with a seed goal and re-sends it if it ever finishes, so the tree's own
  job is to keep replanning and keep driving:

  * 4 Hz replan: a walking person moves ~0.3 m between plans; the old 1 Hz left
    the path a full stride stale and the base visibly late on every turn.
  * Every leaf has a recovery: the goal sits right behind a person who is a
    lidar obstacle, so one failed plan (inflated goal cell) must clear and retry,
    not abort the whole follow. The outer fallback only clears costmaps and
    waits: no Spin/BackUp here, those would break line of sight with the person
    the smoother is steering us back toward.
  * TruncatePath keeps the controller from trying to settle exactly on a goal
    that moves at every tick.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="30" name="FollowRecovery">
      <PipelineSequence name="FollowWithReplanning">
        <RateController hz="4.0">
          <RecoveryNode number_of_retries="2" name="ComputePathToPose">
            <Sequence>
              <GoalUpdater input_goal="{goal}" output_goal="{updated_goal}">
                <ComputePathToPose goal="{updated_goal}" path="{path}" planner_id="GridBased"/>
              </GoalUpdater>
              <TruncatePath distance="0.2" input_path="{path}" output_path="{truncated_path}"/>
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="2" name="FollowPath">
          <KeepRunningUntilFailure>
            <FollowPath path="{truncated_path}" controller_id="FollowPath"/>
          </KeepRunningUntilFailure>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="1"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
