<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="mesh_path" value="file://$(find frida_description)/urdf/meshes/Gripper/Custom/" />

<xacro:macro name="load_gripper" params="attach_to:='' xyz:='0 0 0' rpy:='0 0 0' fixed_joints:='false' mujoco_plugin:=false ros2_control_plugin:='uf_robot_hardware/UFRobotFakeSystemHardware'">
    <xacro:unless value="${attach_to == ''}">
      <joint name="gripper_fix" type="fixed">
        <parent link="${attach_to}"/>
        <child link="gripper"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <axis xyz="0 0 1"/>
      </joint>
    </xacro:unless>

<link name="gripper">
  <inertial>
    <origin xyz="-0.001867 0.013496 0.038407" rpy="0 0 0" />
    <mass value="0.80064" />
    <inertia ixx="0.00034711" ixy="2.2658E-06" ixz="1.5153E-06"
               iyy="0.0020772" iyz="-7.1451E-06" izz="0.0022205" />
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="${mesh_path}gripper.STL" />
    </geometry>
    <material name="">
      <color rgba="1 1 1 1" />
    </material>
  </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}gripper.STL" />
      </geometry>
    </collision>
</link>

<!-- Fingers -->
<xacro:macro name="finger" params="prefix inertial_origin ixx ixy ixz iyy iyz izz">
  <link name="${prefix}_finger">
    <inertial>
      <origin xyz="${inertial_origin}" rpy="0 0 0" />
      <mass value="0.058233" />
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
               iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}${prefix}_finger.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}${prefix}_finger.STL" />
      </geometry>
    </collision>
  </link>
</xacro:macro>

<xacro:finger prefix="right" inertial_origin="0.057738 -0.0019521 0.030032" ixx="2.6744E-05" ixy="5.4499E-08" ixz="-2.3547E-06" iyy="2.5235E-05" iyz="3.2546E-08" izz="1.3060E-05" />
<xacro:finger prefix="left" inertial_origin="-0.037796 0.0021521 0.030032" ixx="2.6744E-05" ixy="5.4499E-08" ixz="2.3547E-06" iyy="2.5235E-05" iyz="-3.2546E-08" izz="1.3060E-05"/>

  
  <xacro:if value="${fixed_joints}">
    <xacro:property name="finger_joint_type" value="fixed" />
  </xacro:if>
  <xacro:unless value="${fixed_joints}"> 
    <xacro:property name="finger_joint_type" value="prismatic" />
  </xacro:unless>

  <!-- SolidWorks export (Nov 2026 gripper) has 0 = closed; origins are shifted
       outward by the 0.0485 stroke and axes flipped to keep the repo convention
       0 = open, upper = closed (xarm_sim_bridge, gripper controllers). -->
  <joint name="rightfinger" type="${finger_joint_type}">
    <origin xyz="0.1175 -0.00205 0.063" rpy="0 0 3.1416" />
    <parent link="gripper" />
    <child link="right_finger" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.0485"
           effort="1" velocity="8" />
    <!-- Real-robot controllers ignore URDF joint dynamics, so this has no
         effect on hardware; kept for completeness/any future simulator. -->
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <joint
    name="leftfinger" type="${finger_joint_type}">
    <origin xyz="-0.097558 -0.00205 0.063" rpy="0 0 3.1416" />
    <parent link="gripper" />
    <child link="left_finger" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.0485"
           effort="1" velocity="8" />
    <mimic joint="rightfinger" multiplier="1" offset="0" />
  </joint>

  <!-- ros2_control for the gripper: declared only for the fake plugin used
       by frida_fake_moveit_config. On real hardware the
       gripper is driven through xarm's separate service API, NOT ros2_control —
       UFRobotSystemHardware needs a robot_ip param per <ros2_control> block,
       and a second instance for the gripper (without its own robot_ip) crashes
       the controller_manager with "No param named 'robot_ip'" → SIGSEGV. For
       fake mode we still need this so rightfinger gets state-published
       (otherwise the finger meshes render at world origin). -->
  <xacro:include filename="$(find frida_description)/urdf/Gripper/Custom/gripper_ros2_control.xacro" />
  <xacro:if value="${'Fake' in ros2_control_plugin}">
    <xacro:gripper_ros2_control
        ros2_control_plugin="${ros2_control_plugin}" />
  </xacro:if>

  </xacro:macro>

  <link name="zed"  />
  <joint name="ZED" type="fixed">
    <!-- ponytail: ZED pose estimated from the gripper mesh (CS_Zed wasn't exported);
         replace with the hand-eye calibration result (perception_3d/hand_eye_calibration.py). -->
    <origin xyz="0 0.0634 0.0291" rpy="0 -0.7854 1.5708" />
    <parent link="gripper" />
    <child link="zed" />
    <axis xyz="0 0 1"/>
  </joint>


  


</robot>