# Request
# Ordered patrol route over the tagged sublocation poses. Nav only plans: the
# caller drives, moves the arm to `arm_poses[i]` and waits `dwell_s[i]`.

string[] areas            # empty = every area that has a polygon
string mode               # "full" | "quick" | "revisit"   ("" -> "full")
int32 max_viewpoints      # 0 = no limit
---
#Response
bool success
geometry_msgs/PoseStamped[] viewpoints   # map frame, in visit order
string[] areas_out                       # area per viewpoint
string[] sublocations                    # furniture name per viewpoint
string[] arm_poses                       # xarm named pose to stare with
float32[] dwell_s                        # seconds to hold at each viewpoint
float64 total_distance                   # meters, straight-line estimate
string error
