<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frida_task_sim</name>
  <version>0.1.0</version>
  <description>Task-level simulation harness: seeded rulebook scenarios, scripted HRI, referee and scoring</description>
  <maintainer email="roborregos@gmail.com">ros</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>frida_gz_sim</exec_depend>
  <exec_depend>frida_constants</exec_depend>
  <exec_depend>frida_interfaces</exec_depend>
  <exec_depend>task_manager</exec_depend>
  <exec_depend>map_context</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
