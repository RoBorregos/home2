<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frida_gz_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation of FRIDA for pick and place (vision + manipulation)</description>
  <maintainer email="roborregos@gmail.com">ros</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xarm_msgs</exec_depend>
  <exec_depend>frida_description</exec_depend>
  <exec_depend>frida_interfaces</exec_depend>
  <exec_depend>frida_constants</exec_depend>
  <exec_depend>arm_pkg</exec_depend>
  <exec_depend>pick_and_place</exec_depend>
  <exec_depend>object_detector_2d</exec_depend>
  <exec_depend>vision_general</exec_depend>
  <exec_depend>task_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
