<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- A2 arm joints on gz_ros2_control, position commanded like the xArm in sim; both start in the rest pose -->
  <xacro:macro name="a2_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="A2ArmsSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:a2_joint name="openarm_right_joint1" initial="0.0"/>
    <xacro:a2_joint name="openarm_right_joint2" initial="0.3"/>
    <xacro:a2_joint name="openarm_right_joint3" initial="0.0"/>
    <xacro:a2_joint name="openarm_right_joint4" initial="2.2"/>
    <xacro:a2_joint name="openarm_right_joint5" initial="0.0"/>
    <xacro:a2_joint name="openarm_right_joint6" initial="0.0"/>
    <xacro:a2_joint name="openarm_right_joint7" initial="0.0"/>
    <xacro:a2_joint name="openarm_left_joint1" initial="0.0"/>
    <xacro:a2_joint name="openarm_left_joint2" initial="-0.3"/>
    <xacro:a2_joint name="openarm_left_joint3" initial="0.0"/>
    <xacro:a2_joint name="openarm_left_joint4" initial="2.2"/>
    <xacro:a2_joint name="openarm_left_joint5" initial="0.0"/>
    <xacro:a2_joint name="openarm_left_joint6" initial="0.0"/>
    <xacro:a2_joint name="openarm_left_joint7" initial="0.0"/>
  </ros2_control>

  <!-- Firmware-like gravity compensation on every arm link -->
  <xacro:macro name="a2_no_gravity" params="side index">
    <gazebo reference="openarm_${side}_link${index}">
      <gravity>false</gravity>
    </gazebo>
    <xacro:if value="${index &lt; 7}">
      <xacro:a2_no_gravity side="${side}" index="${index + 1}"/>
    </xacro:if>
  </xacro:macro>
</robot>
