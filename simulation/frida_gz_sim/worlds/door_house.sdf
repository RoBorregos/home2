<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Two 4 x 6 m rooms joined by a pull door; the robot starts inside (+x) facing the door -->
  <world name="door_house">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="ceiling">
      <pose>1.5 0 2.3 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.68 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fixed overview camera for headless debugging (/sim/overview_camera/image) -->
    <model name="overview_camera">
      <static>true</static>
      <pose>2.6 -2.2 2.2 0 0.5 2.45</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>overview_camera/image</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>800</width><height>600</height></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Close-up on the lever for debugging (/sim/handle_camera/image) -->
    <model name="handle_camera">
      <static>true</static>
      <pose>0.55 -0.85 1.25 0 0.318 2.272</pose>
      <link name="link">
        <sensor name="handle" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>handle_camera/image</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
      <collision name="door_wall_left"><pose>-0.06 -1.7275 1.2 0 0 0</pose><geometry><box><size>0.12 2.545 2.4</size></box></geometry></collision>
      <visual name="door_wall_left"><pose>-0.06 -1.7275 1.2 0 0 0</pose><geometry><box><size>0.12 2.545 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="door_wall_right"><pose>-0.06 1.7275 1.2 0 0 0</pose><geometry><box><size>0.12 2.545 2.4</size></box></geometry></collision>
      <visual name="door_wall_right"><pose>-0.06 1.7275 1.2 0 0 0</pose><geometry><box><size>0.12 2.545 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="door_wall_top"><pose>-0.06 0 2.25 0 0 0</pose><geometry><box><size>0.12 0.91 0.3</size></box></geometry></collision>
      <visual name="door_wall_top"><pose>-0.06 0 2.25 0 0 0</pose><geometry><box><size>0.12 0.91 0.3</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="inside_back"><pose>4.06 0 1.2 0 0 0</pose><geometry><box><size>0.12 6.24 2.4</size></box></geometry></collision>
      <visual name="inside_back"><pose>4.06 0 1.2 0 0 0</pose><geometry><box><size>0.12 6.24 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="inside_left"><pose>2.0 -3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry></collision>
      <visual name="inside_left"><pose>2.0 -3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="inside_right"><pose>2.0 3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry></collision>
      <visual name="inside_right"><pose>2.0 3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="outside_back"><pose>-4.18 0 1.2 0 0 0</pose><geometry><box><size>0.12 6.24 2.4</size></box></geometry></collision>
      <visual name="outside_back"><pose>-4.18 0 1.2 0 0 0</pose><geometry><box><size>0.12 6.24 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="outside_left"><pose>-2.12 -3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry></collision>
      <visual name="outside_left"><pose>-2.12 -3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      <collision name="outside_right"><pose>-2.12 3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry></collision>
      <visual name="outside_right"><pose>-2.12 3.06 1.2 0 0 0</pose><geometry><box><size>4.24 0.12 2.4</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <name>office_door</name>
      <uri>model://office_door</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
